#!/bin/bash

# Path to the main files.txt
FILES_TXT_PATH="/data/data/com.termux/files/home/storage/github/files.txt"

# Path for the list of files to be indexed
INDEXED_FILES_LIST_PATH="/data/data/com.termux/files/home/storage/github/files_list_${CURRENT_TIMESTAMP}.txt"

# Get the current timestamp
CURRENT_TIMESTAMP=$(date +%s)

# Determine LAST_TIMESTAMP from the last file in the most recent files_list_*.txt
LAST_TIMESTAMP=0 # Default to 0 (epoch) if no previous files_list_*.txt found

LATEST_INDEXED_FILES_LIST=$(ls -t /data/data/com.termux/files/home/storage/github/files*.txt 2>/dev/null | head -n 1)

echo LATEST_INDEXED_FILES_LIST $LATEST_INDEXED_FILES_LIST

if [ -n "$LATEST_INDEXED_FILES_LIST" ]; then
    LAST_FILE_IN_LIST=$(tail -n 1 "$LATEST_INDEXED_FILES_LIST")
    echo LAST_FILE_IN_LIST $LAST_FILE_IN_LIST
    if [ -f "$LAST_FILE_IN_LIST" ]; then
        LAST_TIMESTAMP=$(stat -c %Y "$LAST_FILE_IN_LIST")
        echo "Derived LAST_TIMESTAMP from '$LAST_FILE_IN_LIST': $LAST_TIMESTAMP"
    else
        echo "Last file in '$LATEST_INDEXED_FILES_LIST' not found. Starting with all files."
    fi
else
    echo "No previous files_list_*.txt found. Starting with all files."
fi
